    {
        "version": "0.2.0",
        "configurations": [
            {
                "type": "node",
                "request": "launch",
                "name": "Jest: current file",
                "program": "${workspaceFolder}/node_modules/.bin/jest",
                "args": [
                    "--runInBand",
                    "${fileBasenameNoExtension}"
                ],
                "console": "integratedTerminal",
                "internalConsoleOptions": "openOnSessionStart",
                "skipFiles": [
                    "<node_internals>/**",
                    "**/node_modules/**"
                ]
            }
        ]
    }